# 本文件是主 .env 文件的模板.
# 复制本文件到 .env 并填入适当的值.
# 重要: .env 文件不应该被提交到版本控制中.

# --- 项目标识 / 资源隔离 (必须设置!) ---
# 用于隔离不同项目的 Docker 资源（容器、数据卷、数据库）
# 建议使用项目目录名或有意义的短名称，如: crm, admin, api_v2
# 多个项目可以同时运行而不会相互冲突
PROJECT_NAME=fullstack_scaffold

# --- 应用显示名称 (推荐设置) ---
# 用于对外展示：
# - FastAPI OpenAPI 文档 title
# - 前端网站 title（生产环境 / Docker 运行时）
# 本地前端 dev 如需同步显示名，请在 frontend/.env 里设置 NUXT_PUBLIC_APP_NAME
# 未设置时会默认使用 PROJECT_NAME
APP_NAME=全栈脚手架


# --- PostgreSQL 数据库 ---
# 这些变量由 docker-compose.yml 中的 postgres_db 服务使用
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=${PROJECT_NAME}_db

# --- 后端应用 (FastAPI) ---
# 这是后端应用用于连接数据库的连接字符串.
# 对于使用 Docker 的本地开发, 主机名是服务名 'postgres_db'.
# 数据库名会根据 PROJECT_NAME 自动生成，确保项目间隔离
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres_db:5432/${POSTGRES_DB}

# --- Redis (通用) ---
# 用于应用的缓存、速率限制等.
# 对于使用 Docker 的本地开发, 主机名是服务名 'redis'.
REDIS_URL=redis://redis:6379/1

# --- Celery (任务队列) ---
# 用于 Redis 的连接字符串, 作为消息代理和结果后端.
# 注意: 推荐为 Celery 使用独立的 Redis 数据库 (如 DB 0),
# 与通用缓存所用的数据库 (如 DB 1) 分开.
# 对于使用 Docker 的本地开发, 主机名是服务名 'redis'.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- 安全性 ---
# 用于签发 JWT 的强壮、唯一的密钥.
# 可以通过以下命令生成一个: openssl rand -hex 32
SECRET_KEY=a_very_secret_key_that_should_be_changed

# Token 过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- 初始超管账号 ---
# 首次启动时自动创建的超级管理员账号
# 生产环境必须修改 ADMIN_PASSWORD 为强密码，否则服务将拒绝启动
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- 后端 CORS 配置 ---
# 支持逗号分隔（推荐）或 JSON 数组格式
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- 前端配置 ---
# 开发环境推荐使用相对路径 /api/v1（frontend 已配置 nitro devProxy）
# 生产环境可覆盖为完整 URL，例如：https://api.yourdomain.com/api/v1
NUXT_PUBLIC_API_BASE=/api/v1
# Session 加密密码（至少32字符，用于加密 cookie）
NUXT_SESSION_PASSWORD=this-is-a-32-character-string-for-dev-only!

# ========== AI服务配置 ==========
# DeepSeek API配置（必填，用于AI分析功能）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek模型配置（可选，有默认值）
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_MAX_TOKENS=65536
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro
DEEPSEEK_REASONER_MAX_TOKENS=65536
DEEPSEEK_TEMPERATURE=0.0

# DeepSeek 价格配置（CNY/百万 tokens，用于成本统计）
# Chat = V4-Flash；Reasoner = V4-Pro 标准价
DEEPSEEK_CHAT_INPUT_PRICE_PER_MILLION=1.0
DEEPSEEK_CHAT_INPUT_CACHE_HIT_PRICE_PER_MILLION=0.02
DEEPSEEK_CHAT_OUTPUT_PRICE_PER_MILLION=2.0
DEEPSEEK_REASONER_INPUT_PRICE_PER_MILLION=12.0
DEEPSEEK_REASONER_INPUT_CACHE_HIT_PRICE_PER_MILLION=0.1
DEEPSEEK_REASONER_OUTPUT_PRICE_PER_MILLION=24.0

# ========== Celery任务配置 ==========
# 并发度由 docker-compose 的 celery-worker 命令 `--concurrency=100` 统一控制,
# 所有任务类型共享 100 个 gevent greenlet（适合 LLM I/O 密集型）。
CELERY_AI_POSTS_BATCH_SIZE=10
CELERY_AI_NEWS_TAGGING_BATCH_SIZE=10
CELERY_TASK_MAX_ITEMS_LIMIT=20000
CELERY_TASK_MAX_COMMENTS_PER_POST_FOR_DEEP_ANALYSIS=50
DB_COMMIT_AFTER_BATCH_COUNT=20

# 批处理全局分析配置（可选，有默认值）
BATCH_ANALYSIS_DEFAULT_BATCH_SIZE=30
BATCH_ANALYSIS_MIN_BATCH_SIZE=20
BATCH_ANALYSIS_MAX_BATCH_SIZE=40
BATCH_ANALYSIS_MAX_CONCURRENT_BATCHES=100
BATCH_ANALYSIS_CONCURRENT_TIMEOUT=600
BATCH_ANALYSIS_MAX_RETRIES=2
BATCH_ANALYSIS_ENABLE_CONCURRENT=True
BATCH_ANALYSIS_ENABLE_BATCHING=True
BATCH_ANALYSIS_ENABLE_DYNAMIC_SIZING=True
BATCH_ANALYSIS_LOG_TOKEN_USAGE=True

# ========== 数据库连接池优化 ==========
# 针对AI任务的高并发优化（可选，有默认值）
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# ========== 爬虫客户端 Agent API 配置 ==========
# 用于本地爬虫客户端与平台通信的认证密钥
# 可以通过以下命令生成: openssl rand -hex 32
AGENT_API_KEY=sk-change-this-to-a-random-secret-key
# 任务超时时间（小时），超时后 accepted 状态的任务会重置为 pending
AGENT_TASK_TIMEOUT_HOURS=0.5

# ========== Research Agent 搜索服务 ==========
# 专题研究模块使用的搜索服务（可选 tavily / exa）
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=tvly-your-tavily-api-key-here
TAVILY_API_KEY_2=tvly-your-backup-tavily-api-key-here
EXA_API_KEY=your-exa-api-key-here

# ========== 飞书集成（扫码登录 + 个人消息通知） ==========
# 在飞书开放平台创建自建应用后获取
# 需开通权限：im:message（发送消息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# OAuth 回调地址，需在飞书开放平台「安全设置 → 重定向 URL」中添加
FEISHU_OAUTH_REDIRECT_URI=http://localhost:3000/auth/feishu/callback
# 通知卡片中「查看策略」按钮的跳转基础 URL（可选）
FEISHU_FRONTEND_URL=http://localhost:3000

# ========== 知识库向量化（可选） ==========
# 向量嵌入服务 API Key（用于知识库文档向量化）
EMBEDDING_API_KEY=your-embedding-api-key-here

# ========== Crawl4AI ==========
# 文档抓取服务配置（知识库 PDF/网页抓取）
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_TOKEN=
CRAWLER_PDF_TIMEOUT=60
