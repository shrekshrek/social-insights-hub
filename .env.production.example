# ========================================
# 生产环境配置模板
# 复制此文件为 .env.production 并填入实际值
# 警告：不要将 .env.production 提交到版本控制
# ========================================

# === PostgreSQL数据库配置 ===
# 数据库用户名
POSTGRES_USER=postgres

# 数据库密码（生产环境必须使用强密码）
# 生成强密码: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# 数据库名称
POSTGRES_DB=fastapi_db

# === 后端应用配置 ===
# 环境标识（production/staging/development）
ENVIRONMENT=production

# 数据库连接URL
# 重要：密码必须与POSTGRES_PASSWORD完全一致
# 注意：postgres_db 是Docker容器服务名，不要改为localhost
# 建议使用 postgresql+psycopg://（Alembic 迁移使用同步驱动；应用运行时会自动转为 asyncpg）
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_THIS_STRONG_PASSWORD@postgres_db:5432/fastapi_db

# Redis连接配置
# redis 是Docker容器服务名
REDIS_URL=redis://redis:6379/0

# Celery任务队列配置
# 使用不同的Redis数据库编号避免冲突
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# 签名服务策略
# 可用策略：javascript、playwright
SIGNING_STRATEGY=playwright
# Javascript 策略：指向容器内的 JS Bundle（可选）
SIGNING_JS_BUNDLE=
# Playwright 策略：浏览器类型 (chromium | firefox | webkit) 与无头模式
SIGNING_PLAYWRIGHT_BROWSER=chromium
SIGNING_PLAYWRIGHT_HEADLESS=true
SIGNING_PLAYWRIGHT_USER_DATA_DIR=/data/signing/xhs
SIGNING_PLAYWRIGHT_STEALTH_JS=/opt/signing/stealth.min.js
SIGNING_PLAYWRIGHT_DEFAULT_COOKIES=

# JWT安全配置
# 生成命令: openssl rand -hex 32
# 重要：生产环境必须更改此值
SECRET_KEY=CHANGE_THIS_USE_OPENSSL_RAND_HEX_32_TO_GENERATE
ALGORITHM=HS256

# Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15        # 访问令牌：15分钟
REFRESH_TOKEN_EXPIRE_MINUTES=10080    # 刷新令牌：7天

# 项目基本信息
# PROJECT_NAME 用于资源隔离/内部标识，生产环境一般不需要改动
PROJECT_NAME=fullstack_app

# APP_NAME 用于对外展示（API 文档 title / 网站 title）
APP_NAME=全栈应用
API_PREFIX=/api/v1
VERSION=0.1.0

# CORS配置
# 支持逗号分隔或 JSON 数组格式（推荐逗号分隔，便于手工编辑）
# 生产环境应该只包含实际的域名
BACKEND_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# API速率限制（每分钟请求数）
RATE_LIMIT_PER_MINUTE=60

# === 前端应用配置 ===
# Nuxt session加密密码（至少32个字符）
# 生成命令: openssl rand -base64 32
# 重要：生产环境必须更改此值
NUXT_SESSION_PASSWORD=CHANGE_THIS_MUST_BE_AT_LEAST_32_CHARS_USE_OPENSSL

# 客户端 API 基础路径（浏览器发出的请求，经 nginx 路由到 FastAPI）
# nginx 架构下使用相对路径 /api/v1 即可
NUXT_PUBLIC_API_BASE=/api/v1

# SSR 内网 API 地址（Nuxt 服务端渲染时直接访问后端，绕过 nginx）
# 值为 Docker 内部服务名，不经过公网
NUXT_API_BASE_INTERNAL=http://prod-backend:8000/api/v1

# Session Cookie ��全模式
# HTTPS 环境：删除此行（默认 secure: true）
# HTTP 环境：必须设为 false，否则浏览器会丢弃 Set-Cookie
NUXT_SESSION_COOKIE_SECURE=false

# ========================================
# 配置检查清单
# ========================================
# [ ] POSTGRES_PASSWORD 已更改为强密码
# [ ] DATABASE_URL 中的密码与 POSTGRES_PASSWORD 一致
# [ ] SECRET_KEY 已使用 openssl rand -hex 32 生成
# [ ] NUXT_SESSION_PASSWORD 已使用 openssl rand -base64 32 生成
# [ ] BACKEND_CORS_ORIGINS 已配置为实际域名
# [ ] NUXT_API_BASE_INTERNAL 已设为 http://<backend容器名>:8000/api/v1
# [ ] 所有 CHANGE_THIS 值都已更改
# ========================================
