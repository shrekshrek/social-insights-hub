# ========================================
# 生产环境配置模板
# 复制此文件为 .env.production 并填入实际值
# 警告：不要将 .env.production 提交到版本控制
# ========================================

# === 项目标识 ===
PROJECT_NAME=fullstack_app
APP_NAME=全栈应用

# === PostgreSQL数据库配置 ===
POSTGRES_USER=postgres
# 数据库密码（生产环境必须使用强密码）
# 生成强密码: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=fastapi_db

# === 后端应用配置 ===
ENVIRONMENT=production

# 数据库连接URL
# 重要：密码必须与POSTGRES_PASSWORD完全一致
# 注意：postgres_db 是Docker容器服务名，不要改为localhost
# 必须使用 postgresql+psycopg://（psycopg v3，非 psycopg2；代码自动为 FastAPI 转换为 asyncpg，Celery 同步引擎保留 psycopg v3 同步模式）
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_THIS_STRONG_PASSWORD@postgres_db:5432/fastapi_db

# Redis配置
REDIS_URL=redis://redis:6379/1

# Celery任务队列配置
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# === 安全配置 ===
# JWT密钥，生成命令: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_USE_OPENSSL_RAND_HEX_32_TO_GENERATE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3000

# === API配置 ===
API_PREFIX=/api/v1
VERSION=0.1.0

# CORS配置
# 生产环境应该只包含实际的域名或IP
BACKEND_CORS_ORIGINS=http://your-server-ip

# 速率限制
RATE_LIMIT_PER_MINUTE=60

# === 前端应用配置 ===
# Nuxt session加密密码（至少32个字符）
# 生成命令: openssl rand -base64 32
NUXT_SESSION_PASSWORD=CHANGE_THIS_MUST_BE_AT_LEAST_32_CHARS_USE_OPENSSL
# 客户端请求通过 nginx 路由到 FastAPI，使用相对路径
NUXT_PUBLIC_API_BASE=/api/v1
# SSR 请求从 Nuxt 容器直接访问后端内网，绕过 nginx
NUXT_API_BASE_INTERNAL=http://prod-backend:8000/api/v1
# 服务器使用 HTTP 时必须设为 false，否则浏览器会丢弃 Set-Cookie
NUXT_SESSION_COOKIE_SECURE=false

# === AI服务配置 ===
# DeepSeek API 密钥
DEEPSEEK_API_KEY=CHANGE_THIS_TO_YOUR_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型配置
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_CHAT_MAX_TOKENS=8192
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_REASONER_MAX_TOKENS=65536
DEEPSEEK_TEMPERATURE=0.0

# 价格配置（每百万token美元）
DEEPSEEK_CHAT_INPUT_PRICE_PER_MILLION=2.0
DEEPSEEK_CHAT_OUTPUT_PRICE_PER_MILLION=8.0
DEEPSEEK_REASONER_INPUT_PRICE_PER_MILLION=4.0
DEEPSEEK_REASONER_OUTPUT_PRICE_PER_MILLION=16.0

# === Celery任务配置 ===
CELERY_AI_SCREENING_CONCURRENT_STREAMS=100
CELERY_AI_DEEP_ANALYSIS_CONCURRENCY=100
CELERY_AI_POSTS_BATCH_SIZE=5
CELERY_AI_COMMENTS_BATCH_SIZE=10
CELERY_TASK_MAX_ITEMS_LIMIT=20000
CELERY_TASK_MAX_COMMENTS_PER_POST_FOR_DEEP_ANALYSIS=50
DB_COMMIT_AFTER_BATCH_COUNT=20

# === 批处理分析配置 ===
BATCH_ANALYSIS_DEFAULT_BATCH_SIZE=30
BATCH_ANALYSIS_MIN_BATCH_SIZE=20
BATCH_ANALYSIS_MAX_BATCH_SIZE=40
BATCH_ANALYSIS_MAX_CONCURRENT_BATCHES=100
BATCH_ANALYSIS_CONCURRENT_TIMEOUT=600
BATCH_ANALYSIS_MAX_RETRIES=2
BATCH_ANALYSIS_ENABLE_CONCURRENT=True
BATCH_ANALYSIS_ENABLE_BATCHING=True
BATCH_ANALYSIS_ENABLE_DYNAMIC_SIZING=True
BATCH_ANALYSIS_LOG_TOKEN_USAGE=True

# === 数据库连接池优化 ===
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800

# === 爬虫客户端 Agent API ===
# Agent 认证密钥，生成命令: openssl rand -hex 32
AGENT_API_KEY=CHANGE_THIS_TO_YOUR_AGENT_API_KEY
AGENT_TASK_TIMEOUT_HOURS=0.5

# === 签名策略 ===
SIGNING_STRATEGY=javascript
SIGNING_JS_BUNDLE=

# ========================================
# 配置检查清单
# ========================================
# [ ] POSTGRES_PASSWORD 已更改为强密码
# [ ] DATABASE_URL 中的密码与 POSTGRES_PASSWORD 一致
# [ ] SECRET_KEY 已使用 openssl rand -hex 32 生成
# [ ] NUXT_SESSION_PASSWORD 已使用 openssl rand -base64 32 生成
# [ ] DEEPSEEK_API_KEY 已填入有效密钥
# [ ] AGENT_API_KEY 已使用 openssl rand -hex 32 生成
# [ ] BACKEND_CORS_ORIGINS 已配置为实际域名/IP
# [ ] 所有 CHANGE_THIS 值都已更改
# ========================================
